# AIVA Configuration Template
# Скопіюй цей файл як .env і заповни реальними значеннями

# === Telegram Bot ===
BOT_TOKEN=your_telegram_bot_token_here

# === Server ===
AGENT_URL=http://127.0.0.1:8787

# === Database ===
DB_PATH=assistant.db

# === Logging ===
# Рівні: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# === Ollama AI ===
OLLAMA_HOST=http://127.0.0.1:11434

# === Whisper ASR ===
# Розміри моделі: tiny, base, small, medium, large-v3
# Рекомендовано: base (швидко + точно)
ASR_MODEL_SIZE=base
ASR_LANGUAGE=uk
# Пристрій: cpu або cuda (якщо є GPU)
ASR_DEVICE=cpu
# Beam size: 1 (найшвидше) до 5 (точніше)
ASR_BEAM_SIZE=1

# === Weather API ===
# Отримай безкоштовний ключ на https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# === Tuya Smart Home ===
# Отримай на https://iot.tuya.com/
TUYA_ACCESS_ID=your_tuya_access_id_here
TUYA_ACCESS_KEY=your_tuya_access_key_here
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com

# === Optional: Performance ===
# Максимальний розмір кешу AI відповідей
AI_CACHE_SIZE=100
# TTL кешу в секундах
AI_CACHE_TTL=300
# Розмір кешу БД
DB_CACHE_SIZE=128
